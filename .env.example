# ============================================================
# Universal Website Testing Tool - environment configuration
# Copy this file to .env and adjust the values.
# ============================================================

# Required. Target website URL (HTTP or HTTPS).
# The command line can override it:
#   TARGET_URL=https://example.com docker compose run --rm playwright
TARGET_URL=https://example.com

# Browser engine: chromium (default), firefox, or webkit.
BROWSER=chromium

# Ignore invalid/expired TLS certificates. Keep false for real websites.
IGNORE_HTTPS_ERRORS=false

# Optional host allowlist, comma separated. Supports exact hosts and *.example.com.
# Leave empty to allow any target (you must still have permission to test it).
TARGET_HOST_ALLOWLIST=

# ------------------------------------------------------------------
# Timeouts (milliseconds)
# ------------------------------------------------------------------
TEST_TIMEOUT_MS=120000
NAV_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000
EXPECT_TIMEOUT_MS=7000
LINK_CHECK_TIMEOUT_MS=15000

# Extra wait after the load event so client-side rendering can settle.
RENDER_WAIT_MS=500

# ------------------------------------------------------------------
# Crawling and inspection limits
# ------------------------------------------------------------------
# Maximum number of internal URLs checked by links.spec.js.
MAX_PAGES=10
# 1 = links found on the homepage only; 2 = links found on those pages too.
MAX_DEPTH=1
# Maximum number of links collected from the homepage per run.
MAX_LINKS=50
# Maximum number of <img> elements inspected per run.
MAX_IMAGES=50
# Maximum number of forms inspected per run.
MAX_FORMS=10

# Prevent navigation to state-changing URLs during link crawling.
# Comma-separated regular expressions matched against URL and link text.
SKIP_URL_PATTERNS=logout,signout,sign-out,delete,remove,unsubscribe,checkout,place-order

# Detect HTTP 200 pages that look like error pages ("soft 404").
# Disabled by default because heuristics can produce false positives.
DETECT_SOFT_404=false

# ------------------------------------------------------------------
# Assertion policy
# ------------------------------------------------------------------
FAIL_ON_CONSOLE_ERRORS=true
FAIL_ON_PAGE_ERRORS=true

# Comma-separated regular expressions for known/benign errors.
# Example: CONSOLE_ERROR_IGNORE_PATTERNS=third-party-cookie,favicon.ico
CONSOLE_ERROR_IGNORE_PATTERNS=
PAGE_ERROR_IGNORE_PATTERNS=

# Basic synthetic performance budgets.
PERF_DOMCONTENTLOADED_MAX_MS=6000
PERF_LOAD_MAX_MS=12000

# Allowed horizontal overflow in responsive tests (pixels).
OVERFLOW_TOLERANCE_PX=2

# ------------------------------------------------------------------
# Output
# ------------------------------------------------------------------
# Clean reports/ and screenshots/ at the start of every run.
CLEAN_OUTPUT=true
REPORTS_DIR=reports
SCREENSHOTS_DIR=screenshots

# Demo server port (only used with: docker compose --profile demo ...)
DEMO_PORT=8080
